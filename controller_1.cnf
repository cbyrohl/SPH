[xboxdrv]
ui-clear=true
extra-devices=false
extra-events=false
silent=true
deadzone=6000
dpad-as-button=true
trigger-as-button=true

[autofire]
du=150
dd=150
dl=150
dr=150

[ui-axismap]
x2=REL_WHEEL:1:10
y2=REL_WHEEL:-1:10
x1=REL_X:20:20
y1=REL_Y:-20:20

[axismap]
-Y1 = Y1

[ui-buttonmap]
a=KEY_A
b=KEY_B
x=KEY_X
y=KEY_Y

[ui-buttonmap]
lb=KEY_PAGEDOWN
rb=KEY_PAGEUP

[ui-buttonmap]
lt=KEY_L
rt=BTN_FORWARD

[ui-buttonmap]
dl=KEY_LEFT
dr=KEY_RIGHT
du=KEY_UP
dd=KEY_DOWN

[ui-buttonmap]
guide=exec:/home/tiny/startsph

# EOF #
